<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="my_warehouse">

    <!-- System plugins: these MUST be here or the LiDAR/IMU won't publish,
         and SLAM will have nothing to map. -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <physics name="1ms" type="ignored">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Floor -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== Outer walls (room is 12 m x 8 m) ===== -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 4.075 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>12.3 0.15 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>12.3 0.15 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -4.075 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>12.3 0.15 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>12.3 0.15 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>6.075 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.15 8.3 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 8.3 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-6.075 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.15 8.3 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 8.3 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ===== Internal obstacles (things to map) ===== -->
    <model name="shelf_block_1">
      <static>true</static>
      <pose>-2.0 1.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3.0 0.6 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.0 0.6 1.0</size></box></geometry>
          <material><ambient>0.4 0.3 0.2 1</ambient><diffuse>0.5 0.35 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <model name="shelf_block_2">
      <static>true</static>
      <pose>2.0 -1.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3.0 0.6 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.0 0.6 1.0</size></box></geometry>
          <material><ambient>0.4 0.3 0.2 1</ambient><diffuse>0.5 0.35 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <model name="pillar">
      <static>true</static>
      <pose>3.5 2.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
