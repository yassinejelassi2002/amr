<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bringup</name>
  <version>1.0.0</version>
  <description>
    AMR-X bring-up: top-level launch files that start the robot description,
    Gazebo simulation, the ROS-Gazebo bridge, teleoperation, and RViz together.
    Defaults to Jazzy/Harmonic and keeps Humble/Fortress as a compatibility
    mode. This is the package most users launch from.
  </description>
  <maintainer email="zeyneb@amr-x.local">ZEYNEB</maintainer>
  <author>ZEYNEB (ROS 2 Integration Lead)</author>
  <author>mouhamed bouzidi (Digital Twin Lead)</author>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_description</exec_depend>
  <exec_depend>simulation</exec_depend>
  <exec_depend>control</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <exec_depend>teleop_twist_joy</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
