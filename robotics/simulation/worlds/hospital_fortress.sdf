      <pose>0 -23 3.2 0 0 0</pose>
      <diffuse>0.96 0.93 0.86 1</diffuse>
      <specular>0.28 0.25 0.20 1</specular>
      <attenuation><range>16</range><constant>0.55</constant><linear>0.025</linear><quadratic>0.006</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>
