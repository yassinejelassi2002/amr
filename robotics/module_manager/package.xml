<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>module_manager</name>
  <version>0.1.0</version>
  <description>
    Transition layer for AMR-X: attach/detach modules (DockModule/UndockModule
    actions), change operating mode (SetRobotMode service), and publish robot +
    docking state. Owner: Zeyneb (architecture / communication / transition).
  </description>
  <maintainer email="zeyneb@amr-x.local">ZEYNEB</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>amr_interfaces</depend>
  <depend>ament_index_python</depend>

  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export><build_type>ament_python</build_type></export>
</package>
