<?xml version="1.0"?>
<!-- =========================================================================
     amr_real.urdf.xacro  -  wraps the SolidWorks CAD export (AMR-X_robot.urdf)
     and adds everything Nav2 / Gazebo Harmonic need but the CAD file lacks:
       - base_footprint frame (Nav2 / SLAM ground reference)
       - differential-drive plugin pointed at the REAL wheels (DL_joint/DR_joint)
       - joint-state + sensors system plugins
       - LiDAR + IMU sensors
       - zero-friction casters

     Build:  xacro amr_real.urdf.xacro > amr_real.urdf
     ========================================================================= -->
<robot name="amr_x_real" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================================================================
       >>> VERIFY THESE THREE NUMBERS against your real robot / RViz <<<
       =================================================================== -->
  <xacro:property name="wheel_radius"     value="0.080"/>   <!-- metres: measured from DR_Link/DL_Link.STL bounding box (was 0.060, wrong scale -> odom drift) -->
  <xacro:property name="wheel_separation" value="0.5787"/>  <!-- CAD joint centres: 2 x 0.28935 m -->
  <xacro:property name="base_to_axle_z"   value="0.3305"/>  <!-- CAD: base_link height above wheel axle (DR/DL joint z = -0.3305) -->

  <!-- LiDAR + IMU mount points on base_link (EDIT to real positions) -->
  <!-- Front CAD LiDAR puck centre is x=0.3447, y=-0.0044.  Place the
       simulated scan plane near the puck's optical top surface. -->
  <xacro:property name="lidar_xyz" value="0.3447 -0.0044 -0.068"/>
  <xacro:property name="imu_xyz"   value="0 0 0.0"/>    <!-- near chassis centre; adjust -->

  <!-- ===================================================================
       1. Pull in the CAD export (all links + joints + meshes)
       =================================================================== -->
  <xacro:include filename="$(find robot_description)/urdf/AMR-X_robot.urdf"/>

  <!-- ===================================================================
       2. base_footprint : ground-projected frame under base_link.
          base_link sits (base_to_axle_z) above the axle, and the wheel
          contacts the floor one wheel_radius below the axle, so the floor
          is (base_to_axle_z + wheel_radius) below base_link.
       =================================================================== -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${base_to_axle_z + wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ===================================================================
       3. Sensor frames mounted on base_link
       =================================================================== -->
  <link name="lidar_link"/>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_link"/>
    <origin xyz="${lidar_xyz}" rpy="0 0 0"/>
  </joint>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="${imu_xyz}" rpy="0 0 0"/>
  </joint>

  <!-- ===================================================================
       4. Gazebo Harmonic plugins
       =================================================================== -->
  <gazebo>
    <!-- Differential drive on the REAL wheels -->
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>DL_joint</left_joint>
      <right_joint>DR_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <max_linear_velocity>2.0</max_linear_velocity>
      <min_linear_velocity>-2.0</min_linear_velocity>
      <max_angular_velocity>1.8</max_angular_velocity>
      <min_angular_velocity>-1.8</min_angular_velocity>
      <!-- Avoid an instantaneous wheel-speed step, which otherwise produces
           a large initial slip and immediately corrupts wheel odometry. -->
      <max_linear_acceleration>0.5</max_linear_acceleration>
      <min_linear_acceleration>-0.5</min_linear_acceleration>
      <max_angular_acceleration>1.5</max_angular_acceleration>
      <min_angular_acceleration>-1.5</min_angular_acceleration>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>

    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo>

  <!-- ===================================================================
       5. LiDAR + IMU sensors (Harmonic)
       =================================================================== -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
    </sensor>
  </gazebo>

  <!-- ===================================================================
       6. Passive caster contact
       Low rolling friction lets each wheel spin; higher lateral friction and
       the caster trail rotate the swivel into the direction of travel.
       =================================================================== -->
  <gazebo reference="FR_Caster_Wheel_Link"><mu1>0.1</mu1><mu2>0.2</mu2><fdir1>1 0 0</fdir1></gazebo>
  <gazebo reference="FL_Caster_Wheel_Link"><mu1>0.1</mu1><mu2>0.2</mu2><fdir1>1 0 0</fdir1></gazebo>
  <gazebo reference="BR_Caster_Wheel_Link"><mu1>0.1</mu1><mu2>0.2</mu2><fdir1>1 0 0</fdir1></gazebo>
  <gazebo reference="BL_Caster_Wheel_Link"><mu1>0.1</mu1><mu2>0.2</mu2><fdir1>1 0 0</fdir1></gazebo>

  <!-- Positive drive-wheel traction. Primitive cylinder collisions in the CAD
       URDF provide a smooth rolling surface; these values prevent sustained
       wheel slip without making differential-drive turning excessively stiff. -->
  <gazebo reference="DR_Link"><mu1>3.0</mu1><mu2>3.0</mu2></gazebo>
  <gazebo reference="DL_Link"><mu1>3.0</mu1><mu2>3.0</mu2></gazebo>

</robot>
