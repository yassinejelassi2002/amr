<?xml version="1.0"?>
<!-- =========================================================================
     amr_inspection.urdf.xacro  -  FULL nav base robot + inspection module.

     Includes the canonical nav base (amr_2lidar.urdf.xacro) UNCHANGED and
     adds the inspection sensor cluster on top:
       - cameras_mount_Link   (mount bracket, attached to base_link)
       - camera_thermal_Link  (thermal camera, attached to the mount)
       - GAZ_sensor_Link      (gas sensor, attached to base_link)

     Load THIS file for inspection work. The nav stack keeps loading
     amr_2lidar.urdf.xacro, which is untouched. Single source of truth for
     the base robot: any base change made for nav is inherited here via the
     include below.

     Build:  xacro amr_inspection.urdf.xacro > amr_inspection.urdf

     NOTE: SolidWorks exported cameras_mount_joint as a zero-range
     prismatic joint (lower=0 upper=0). It has been set to 'fixed' here,
     which is the correct type for a rigid mount. If the mount is meant to
     actuate, change it back to prismatic and give it real limits.
     ========================================================================= -->
<robot name="amr_x_inspection" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==== entire nav base robot (chassis, wheels, casters, both LiDARs,
          base_footprint, imu, camera frames, Gazebo plugins) ==== -->
  <xacro:include filename="$(find robot_description)/urdf/amr_2lidar.urdf.xacro"/>

  <!-- =====================================================================
       INSPECTION MODULE
       ===================================================================== -->

  <!-- ==== camera mount bracket (on base_link) ==== -->
  <link name="cameras_mount_Link">
    <inertial>
      <origin xyz="-0.040236 0.013428 -0.026709" rpy="0 0 0"/>
      <mass value="0.14071"/>
      <inertia ixx="5.798E-05"  ixy="3.3384E-07"  ixz="-1.7319E-07"
               iyy="1.6986E-05" iyz="1.6883E-08"  izz="5.5627E-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/cameras_mount_Link.STL"/>
      </geometry>
      <material name="amrx_medical_teal">
        <color rgba="0 0.38 0.46 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/cameras_mount_Link.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="cameras_mount_joint" type="fixed">
    <origin xyz="0.51252 -0.0115 0.13975" rpy="0 0.020136 0"/>
    <parent link="base_link"/>
    <child  link="cameras_mount_Link"/>
  </joint>

  <!-- ==== thermal camera (on the mount) ==== -->
  <link name="camera_thermal_Link">
    <inertial>
      <origin xyz="-0.025189 4.4462E-06 -7.318E-05" rpy="0 0 0"/>
      <mass value="0.008096"/>
      <inertia ixx="6.1294E-07"  ixy="7.4569E-11"  ixz="-1.4303E-09"
               iyy="4.3511E-07"  iyz="-4.9824E-11" izz="4.3599E-07"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/camera_thermal_Link.STL"/>
      </geometry>
      <material name="amrx_sensor_graphite">
        <color rgba="0.06 0.08 0.10 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/camera_thermal_Link.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="camera_thermal_joint" type="fixed">
    <origin xyz="0.018405 0.0095726 0.02568" rpy="0 0 0"/>
    <parent link="cameras_mount_Link"/>
    <child  link="camera_thermal_Link"/>
  </joint>

  <!-- ==== gas sensor (on base_link) ==== -->
  <link name="GAZ_sensor_Link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/GAZ_sensor_Link.STL"/>
      </geometry>
      <material name="amrx_porcelain_white">
        <color rgba="0.82 0.86 0.88 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/GAZ_sensor_Link.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="GAZ_sensor_Joint" type="fixed">
    <origin xyz="0.23945 -0.30074 -0.235" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="GAZ_sensor_Link"/>
  </joint>

</robot>
